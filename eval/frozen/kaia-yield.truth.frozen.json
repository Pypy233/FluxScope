      "st_emergency": "strategist, yVault governance/guardian/management",
      "cooldown": "CooldownVault instance",
      "strategy": "CustomYearnStrategy instance",
      "customVault": "CustomVault instance",
      "cvault_operator": "CustomVault operator or governance",
      "cvault_governance": "CustomVault.governance",
      "cs_strategist": "CustomStrategy strategist or governance"
    },
    "assets": {
      "cv": "CooldownVault share token (CooldownVault itself)",
      "usdt": "underlying token (CooldownVault._underlying = CustomVault asset = strategy.externalUnderlyingToken)",
      "cvshare": "CustomVault share token",
      "request": "redeem request recorded in CooldownVault.redeemRequests (non-tokenized claim)",
      "claim:strategy": "Yearn vault's non-tokenized claim on CustomYearnStrategy",
      "claim:customStrategy": "CustomVault's non-tokenized claim on CustomStrategy",
      "claim:predeposit": "CooldownVault's receivable from a strategy's predeposit debt",
      "debt:predeposit": "strategy's predeposit debt to the CooldownVault"
    },
    "holders": {
      "authorized": "authorized CooldownVault share holder",
      "receiver": "redeem-request receiver",
      "cooldown": "CooldownVault",
      "yvault": "Yearn V2 vault (external)",
